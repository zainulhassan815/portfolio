# Contact form. Without this the form refuses to claim delivery and tells the
# visitor to email directly instead.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared sender, which works without a verified
# domain but lands in spam more often. Set once dreamerslab.dev is verified.
CONTACT_FROM="Dreamers Lab <hello@dreamerslab.dev>"
CONTACT_TO=dreamerslabdev@gmail.com

# Canonical origin, used for OG tags, canonicals and the sitemap. Must be set
# at BUILD time, not runtime: metadata for static pages is baked during the
# build. Falls back to the Vercel deployment URL, then localhost.
NEXT_PUBLIC_SITE_URL=https://dreamerslab.dev

# Hostnames that also resolve to this app and should 308 to the canonical one.
# Comma separated. Leave unset to use the default in next.config.ts.
ALT_HOSTS=zainulhassan.dreamerslab.dev
